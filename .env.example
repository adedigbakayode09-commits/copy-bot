# Personal-account client (personal_trade_bot.py): obtain from my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Session defaults outside the checkout; authorize locally with --login.
# TELEGRAM_SESSION_PATH=
# Bot token only for the optional Bot API clients, not personal access.
TELEGRAM_BOT_TOKEN=
SOURCE_CHAT_NAME="TheGoldenEdgeVIP"
# Optional numeric IDs take precedence over the exact group name above.
SOURCE_CHAT_IDS=-1004418162453
# TheGoldenEdge V2 is topic 5 inside TheGoldenEdgeVIP, not a separate group.
SOURCE_TOPIC_ID=5
# Maximum time a fresh setup may wait for its entry zone (default: 15 minutes).
ENTRY_WAIT_SECONDS=900
DESTINATION_CHAT_ID=-1001122334455
# For trade_bot.py --execute only. Use the account already logged in to MT5.
MT5_ACCOUNT_ID=
MT5_LOTS=0.1
# Lot sizes for TP1, TP2, TP3. Entire 0.1 lot closes; no OPEN portion.
# Must sum to MT5_LOTS. Independent TP positions require a hedging account.
MT5_TARGET_LOTS=0.05,0.03,0.02
